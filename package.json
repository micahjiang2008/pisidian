{
  "name": "pisidian",
  "version": "1.0.0",
  "description": "An Obsidian plugin built with Svelte and Tailwind CSS",
  "main": "main.js",
  "scripts": {
    "dev": "concurrently -k \"node esbuild.config.mjs\" \"postcss src/styles.css -o styles.css --watch --verbose\"",
    "build": "node esbuild.config.mjs production && postcss src/styles.css -o styles.css",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "obsidian",
    "plugin"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@tsconfig/svelte": "^5.0.4",
    "@types/node": "^25.9.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "esbuild": "^0.24.0",
    "esbuild-svelte": "^0.9.0",
    "obsidian": "^1.7.2",
    "postcss": "^8.4.47",
    "postcss-cli": "^11.0.0",
    "svelte": "^5.1.0",
    "svelte-preprocess": "^6.0.4",
    "tailwindcss": "^3.4.14",
    "tslib": "^2.8.0",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@lucide/svelte": "^1.16.0"
  }
}
